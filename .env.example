# ──────────────────────────────────────────────────────────────────────────
# Meridian environment
# Copy to .env for local development. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgres://meridian:meridian_local_dev@127.0.0.1:5432/meridian
REDIS_URL=redis://127.0.0.1:6379

# Password for the bundled Postgres container (local dev only).
POSTGRES_PASSWORD=meridian_local_dev

# ─── App URLs (internal on Railway) ──────────
API_URL=http://127.0.0.1:3001
MCP_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ─── Auth ──────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://127.0.0.1:3000

# ─── AI (bring your own key) ───────────────────
ANTHROPIC_API_KEY=
MERIDIAN_LLM_MODEL=claude-sonnet-4-20250514

# ─── Worker ────────────────────────────────────
WORKER_CONCURRENCY=5

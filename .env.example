# ──────────────────────────────────────────────────────────────────────────
# Meridian environment
# Copy to .env for local development. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgres://meridian:meridian_local_dev@127.0.0.1:5432/meridian
REDIS_URL=redis://127.0.0.1:6379

# Password for the bundled Postgres container (local dev only).
POSTGRES_PASSWORD=meridian_local_dev

# ─── App URLs (internal on Railway) ──────────
API_URL=http://127.0.0.1:3001
MCP_URL=http://127.0.0.1:8080

# The MCP bridge binds to loopback. Set this only when another container must
# reach it, and never expose it publicly — it is a full CRUD surface.
# MCP_BIND=0.0.0.0
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ─── Browser origins ───────────────────────────
# Comma-separated allowlist for CORS. Falls back to NEXT_PUBLIC_APP_URL when
# unset. In production an unset value allows nothing (and warns at boot) rather
# than quietly trusting localhost.
# MERIDIAN_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ─── Database tuning ───────────────────────────
# Connections per instance. Hosted Postgres caps this globally and shares it
# across every service, so an unbounded pool is how a deploy runs out.
# MERIDIAN_DB_POOL_MAX=10
# MERIDIAN_DB_IDLE_TIMEOUT_S=30
# MERIDIAN_DB_CONNECT_TIMEOUT_S=10

# Cap on any single request-path query. Migrations are deliberately exempt —
# an index build on a large table is allowed to take as long as it takes.
# MERIDIAN_STATEMENT_TIMEOUT_MS=30000

# ─── Auth ──────────────────────────────────────
# Secret used to sign session tokens (HMAC-SHA256). REQUIRED in production.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# How long a user's session version is cached before it is re-read. Bounds how
# long a revoked session (password change, role change, removal) keeps working.
# 0 makes revocation immediate, at one indexed lookup per request.
# MERIDIAN_SESSION_CACHE_MS=15000

# ─── AI (bring your own key) ───────────────────
ANTHROPIC_API_KEY=

# Each AI job runs on the cheapest model that does it well. Override any of
# them per environment; MERIDIAN_LLM_MODEL pins every task at once.
# MERIDIAN_LLM_MODEL=
MERIDIAN_LLM_MODEL_BRIEFING=claude-haiku-4-5
MERIDIAN_LLM_MODEL_CHAT=claude-sonnet-5
MERIDIAN_LLM_MODEL_AUTOMATION=claude-sonnet-5
MERIDIAN_LLM_MODEL_MAPPING=claude-sonnet-5

# How long a dashboard briefing is reused before it is regenerated (ms).
MERIDIAN_BRIEFING_TTL_MS=600000

# ─── Bootstrap (Railway-friendly) ──────────────
# Password for the seeded admin. Unset, a local instance gets `demo1234` and a
# production one gets a random password printed once in the boot log — a known
# password on a public URL is not a default worth having.
# DEMO_ADMIN_PASSWORD=
# Apply pending migrations on API boot; seed the demo tenant on first boot.
# Migrations are versioned files under packages/core/drizzle — see
# docs/schema-migrations.md.
AUTO_MIGRATE=true
AUTO_SEED=true

# ─── Worker ────────────────────────────────────
WORKER_CONCURRENCY=5
